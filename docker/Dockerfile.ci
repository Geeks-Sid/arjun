# CI image: CPU-only quality gate (lint, typecheck, CPU tests, smoke).
# Base pinned by immutable version tag; pin by digest for release pipelines.
FROM python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/medfm-venv \
    PATH="/opt/medfm-venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends git make \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.14 /uv /uvx /usr/local/bin/

RUN useradd --create-home --shell /bin/bash medfm
WORKDIR /workspace

COPY --chown=medfm:medfm . .

USER medfm
RUN uv sync --frozen --extra medical --extra hf --all-groups

CMD ["bash", "-c", "make lint && make typecheck && make test && make smoke"]
